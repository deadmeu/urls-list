{
  "manifest_version": 2,
  "name": "Better URLs List",
  "version": "0.7.0",
  "description": "List the URLs of all tabs from the current window as copyable plaintext.",
  "homepage_url": "https://github.com/deadmeu/urls-list",
  "browser_specific_settings": {
    "gecko": {
      "id": "{772b01a8-893d-44d5-92aa-a1fd5e318171}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "browser_style": true,
    "default_icon": "icons/icon.svg",
    "default_title": "URLs List",
    "default_popup": "popup/urls-list.html",
    "theme_icons": [{
      "light": "icons/icon-light.svg",
      "dark": "icons/icon.svg",
      "size": 16
    }]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
